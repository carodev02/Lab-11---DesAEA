@{
    ViewData["Title"] = "Catálogo";
}
@Html.AntiForgeryToken()
<main class="catalog-shell">
    <header class="page-head"><div><span class="eyebrow">GESTIÓN COMERCIAL</span><h1>Catálogo de productos</h1><p>Controla tus productos, existencias y categorías.</p></div><div class="head-actions"><button class="btn-quiet" id="gestionarCategorias">Administrar categorías</button><button class="btn-primary" id="nuevo">＋ Nuevo producto</button></div></header>
    <section class="stats"><article><span>Productos activos</span><strong id="total">0</strong><small>En el catálogo</small></article><article><span>Unidades en stock</span><strong id="unidades">0</strong><small>Existencias actuales</small></article><article><span>Por reponer</span><strong id="stockBajo">0</strong><small>Productos con menos de 6 unidades</small></article></section>
    <section class="insights"><article class="panel insight-card"><div class="insight-heading"><div><span class="eyebrow">DISTRIBUCIÓN</span><h2>Productos por categoría</h2></div><span class="insight-icon">◉</span></div><div id="categoryChart" class="category-chart"></div></article><article class="panel insight-card"><div class="insight-heading"><div><span class="eyebrow">ATENCIÓN</span><h2>Inventario por reponer</h2></div><span class="alert-count" id="alertCount">0</span></div><div id="lowStockList" class="low-stock-list"></div></article><article class="panel insight-card recent-card"><div class="insight-heading"><div><span class="eyebrow">MOVIMIENTO</span><h2>Productos recientes</h2></div><span class="insight-icon">↗</span></div><div id="recentList" class="recent-list"></div></article></section>
    <section class="panel"><div class="panel-head"><div><h2>Productos</h2><p>Busca y filtra tu inventario.</p></div><div class="table-filters"><label class="search">⌕ <input id="buscar" placeholder="Buscar producto" /></label><select id="filtrarCategoria"><option value="">Todas las categorías</option></select><select id="filtrarEstado"><option value="">Todo el stock</option><option value="bajo">Por reponer</option><option value="agotado">Agotados</option></select></div></div>
        <div class="table-wrap"><table><thead><tr><th>PRODUCTO</th><th>CATEGORÍA</th><th>PRECIO</th><th>STOCK</th><th></th></tr></thead><tbody id="filas"></tbody></table></div>
        <div class="empty" id="vacio" hidden><span>◇</span><strong>No hay productos para mostrar</strong><small>Prueba otra búsqueda o registra un producto nuevo.</small></div>
    </section>
</main>
<dialog id="editor"><form id="formProducto"><div class="modal-head"><div><span class="eyebrow">CATÁLOGO</span><h2 id="tituloModal">Nuevo producto</h2></div><button type="button" class="close" id="cerrar">×</button></div><input type="hidden" name="Id" value="0"/><label>Nombre del producto<input name="Nombre" required maxlength="120" placeholder="Ej. Cuaderno universitario" /></label><label>Descripción<input name="Descripcion" maxlength="300" placeholder="Detalle breve del producto" /></label><div class="form-grid"><label>Precio (S/)<input name="Precio" type="number" min="0.01" step="0.01" required placeholder="0.00" /></label><label>Stock<input name="Stock" type="number" min="0" required placeholder="0" /></label></div><label>Categoría<select name="CategoriaId" required id="categoria"><option value="">Seleccionar categoría</option></select></label><div class="modal-actions"><button type="button" class="btn-quiet" id="cancelar">Cancelar</button><button class="btn-primary">Guardar producto</button></div></form></dialog>
<div class="toast" id="toast"></div>
<dialog id="categoriasModal"><div class="category-modal"><div class="modal-head"><div><span class="eyebrow">ORGANIZACIÓN</span><h2>Categorías</h2></div><button type="button" class="close" id="cerrarCategorias">×</button></div><p class="category-intro">Agrupa tus productos para encontrarlos con facilidad.</p><form id="formCategoria"><input type="hidden" name="Id" value="0"/><label>Nombre de categoría<input name="Nombre" required maxlength="80" placeholder="Ej. Papelería"/></label><label>Descripción<input name="Descripcion" maxlength="240" placeholder="¿Qué productos incluye?"/></label><div class="modal-actions"><button class="btn-primary">Agregar categoría</button></div></form><div class="category-list" id="listaCategorias"></div></div></dialog>
@section Scripts { <script src="~/js/catalogo.js" asp-append-version="true"></script> }
